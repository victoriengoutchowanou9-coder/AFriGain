# Variables Supabase Client & Server
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (opérations serveur sécurisées backend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clés API Optionnelles pour le Business Coach IA (AfriGain AI)
# Si aucune clé n'est fournie, le moteur contextuel natif hautement optimisé prend le relais automatiquement.
# Option 1: Google Gemini (Recommandé pour rapidité et gratuité/faible coût)
# GEMINI_API_KEY=AIzaSy...
# Option 2: Groq (Llama 3.1 ultra rapide)
# GROQ_API_KEY=gsk_...
# Option 3: OpenAI (GPT-4o-mini)
# OPENAI_API_KEY=sk-...
# Option 4: Clé générique ou endpoint custom
# AI_API_KEY=your-key-here
# AI_MODEL=gemini-1.5-flash
# AI_BASE_URL=https://api.openai.com/v1
